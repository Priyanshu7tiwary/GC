# Copy to .env and fill in. Never commit .env.

POSTGRES_DB=catalyst
POSTGRES_USER=catalyst
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 48   (at least 32 bytes)
JWT_SECRET=

# Google sign-in: OAuth 2.0 "Web application" client ID from https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3000 and http://localhost:5173 (plus your real domain)
GOOGLE_CLIENT_ID=
# Comma-separated verified emails that may correct answer keys (or set users.is_admin in the database)
ADMIN_EMAILS=
# Optional: lets the mock generator draft new questions with Claude (each one checked by an independent solve)
ANTHROPIC_API_KEY=

# Email for one-time codes. The defaults use the local Mailpit container (view mail at http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=99ile <no-reply@99ile.local>

# Set to false only if you serve the site over plain HTTP on a non-localhost address (not recommended).
COOKIE_SECURE=true
# Expose /swagger-ui.html on the API port (never through the public site).
API_DOCS_ENABLED=false

# AI study-plan suggestions (topics to cover + tests to attempt). Any OpenAI-compatible API works.
# Default: Groq's free tier, which serves open-weight models such as OpenAI's gpt-oss. Key: https://console.groq.com/keys
# Leave AI_API_KEY empty to keep the built-in rule-based suggestions.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# Used when the main model is rate-limited (Groq limits each model separately); leave empty to turn off
AI_FALLBACK_MODEL=openai/gpt-oss-20b
# AI plans each learner may generate per rolling 7 days
AI_WEEKLY_LIMIT=3

# ---- production only (docker-compose.prod.yml, see DEPLOY.md) ----
# Your domain, pointing at the server; Caddy gets an HTTPS certificate for it automatically
DOMAIN=
# Let's Encrypt sends certificate notices here
ACME_EMAIL=
# Daily database backups kept in ./backups
BACKUP_KEEP_DAYS=14

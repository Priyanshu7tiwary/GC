# Copy to .env and fill in. Never commit .env.

POSTGRES_DB=catalyst
POSTGRES_USER=catalyst
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 48   (at least 32 bytes)
JWT_SECRET=

# Google sign-in: OAuth 2.0 "Web application" client ID from https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3000 and http://localhost:5173 (plus your real domain)
GOOGLE_CLIENT_ID=

# Email for one-time codes. The defaults use the local Mailpit container (view mail at http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=CATalyst <no-reply@catalyst.local>

# Set to false only if you serve the site over plain HTTP on a non-localhost address (not recommended).
COOKIE_SECURE=true
# Expose /swagger-ui.html on the API port (never through the public site).
API_DOCS_ENABLED=false
